        {
          "name": "Get Approved Reviews",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Mengambil review yang berstatus approved. Parameter limit default 5 dan dibatasi maksimum 20.",
            "url": {
              "raw": "{{base_url}}/public/reviews?limit={{review_limit}}",
              "host": ["{{base_url}}"],
              "path": ["public", "reviews"],
              "query": [
                {
                  "key": "limit",
                  "value": "{{review_limit}}",
                  "description": "Jumlah review, default 5, minimum efektif 5 untuk nilai kurang dari 1, maksimum 20."
                }
              ]
                }
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test('Response has approved reviews data', function () {",
                      "    const json = pm.response.json();",
                      "    pm.expect(json).to.have.property('success', true);",
                      "    pm.expect(json.data).to.be.an('array');",
                      "    pm.expect(json.data.length).to.be.at.most(20);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Submit Visitor Review",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "description": "Mengirim ulasan baru untuk moderasi. Review baru berstatus pending dan tidak langsung tampil di daftar publik. Batas: 5 request per 15 menit per IP.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reviewer_name\": \"Nama Pengunjung\",\n  \"rating\": 5,\n  \"comment_text\": \"Wahana dan fasilitasnya menyenangkan.\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/public/reviews",
                  "host": ["{{base_url}}"],
                  "path": ["public", "reviews"]
                }
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Review is created and queued for moderation', function () {",
                      "    pm.response.to.have.status(201);",
                      "    const json = pm.response.json();",
                      "    pm.expect(json).to.have.property('success', true);",
                      "    pm.expect(json.data.status).to.eql('pending');",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
              "name": "Admin API",
              "description": "Login menggunakan kredensial admin. Siapkan environment variables admin_email dan admin_password. Jalankan Login Admin terlebih dahulu untuk menyimpan admin_token.",
              "item": [
                {
                  "name": "Login Admin",
                  "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "description": "Login admin. Kredensial admin dibuat melalui perintah artisan admin:create. Login dibatasi 5 kali per 15 menit per kombinasi IP dan email. Token berlaku 8 jam.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/admin/login",
                  "host": ["{{base_url}}"],
                  "path": ["admin", "login"]
                }
                  },
                  "response": [],
                  "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Admin login succeeds', function () {",
                      "    pm.response.to.have.status(200);",
                      "    const json = pm.response.json();",
                      "    pm.expect(json).to.have.property('success', true);",
                      "    pm.expect(json.data.token_type).to.eql('Bearer');",
                      "    pm.expect(json.data.admin).to.have.property('email');",
                      "    pm.environment.set('admin_token', json.data.token);",
                      "});"
                    ]
                  }
                }
                  ]
                },
                {
                  "name": "Get Admin Dashboard Overview",
                  "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "description": "Mengambil jumlah profil, tiket aktif, wahana, fasilitas, layanan hydrotherapy, galeri, promo, event, sponsor, ringkasan review, dan 10 review terbaru. Memerlukan token admin.",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{admin_token}}",
                      "type": "string"
                    }
                  ]
                },
                "url": {
                  "raw": "{{base_url}}/admin/dashboard",
                  "host": ["{{base_url}}"],
                  "path": ["admin", "dashboard"]
                }
                  },
                  "response": [],
                  "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Admin dashboard is returned', function () {",
                      "    pm.response.to.have.status(200);",
                      "    const json = pm.response.json();",
                      "    pm.expect(json).to.have.property('success', true);",
                      "    pm.expect(json.data.content).to.have.property('active_tickets');",
                      "    pm.expect(json.data.reviews).to.have.property('pending');",
                      "    pm.expect(json.data.reviews.recent).to.be.an('array');",
                      "});"
                    ]
                  }
                }
                  ]
                },
                {
                  "name": "Logout Admin",
                  "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "description": "Mencabut token admin aktif. Setelah logout, jalankan Login Admin lagi sebelum meminta dashboard.",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{admin_token}}",
                      "type": "string"
                    }
                  ]
                },
                "url": {
                  "raw": "{{base_url}}/admin/logout",
                  "host": ["{{base_url}}"],
                  "path": ["admin", "logout"]
                }
                  },
                  "response": [],
                  "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Admin token is revoked', function () {",
                      "    pm.response.to.have.status(200);",
                      "    pm.environment.unset('admin_token');",
                      "});"
                    ]
                  }
                }
                  ]
                }
      ]
