{
  "info": {
    "_postman_id": "c1d6d5c1-6a0f-4b25-9f7d-4d8e3d0b3f01",
    "name": "Galaxy Waterpark API",
    "description": "Public API dan Admin API Galaxy Waterpark. Endpoint publik tidak memerlukan autentikasi; endpoint admin menggunakan Sanctum bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "review_limit",
      "value": "5",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public API",
      "description": "Endpoint publik untuk informasi waterpark. GET dibatasi 100 request per 15 menit per IP. Pengiriman review dibatasi 5 request per 15 menit per IP.",
      "item": [
        {
          "name": "Get Homepage Data",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Mengambil data gabungan untuk homepage: profil, tiket, wahana/fasilitas/hydrotherapy unggulan, galeri, promo, event, dan sponsor.",
            "url": {
              "raw": "{{base_url}}/public/home",
              "host": ["{{base_url}}"],
              "path": ["public", "home"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains homepage data', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('success', true);",
                  "    pm.expect(json.data).to.have.property('profile');",
                  "    pm.expect(json.data.tickets).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Company Profile",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Mengambil profil perusahaan. Mengembalikan HTTP 404 jika data profil belum tersedia.",
            "url": {
              "raw": "{{base_url}}/public/profile",
              "host": ["{{base_url}}"],
              "path": ["public", "profile"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 404', function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Response is JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});"
                ]
              }
            }
          ]
        },
